#include<stdio.h>
int main()
{
int n1,n2,sum,sub,div,mul,mod;
printf("Enter value of n1:");
scanf("%d",&n1);
printf("Enter value of n2:");
scanf("%d",&n2);
sum=n1+n2;
sub=n1-n2;
div=n1/n2;
mul=n1*n2;
mod=n1%n2;
printf("Addition=%d",sum);
printf("\nSubtraction=%d",sub);
printf("\nDivision=%d",div);
printf("\nMultiplication=%d",mul);
printf("\nModulus=%d",mod);
return 0;
}
